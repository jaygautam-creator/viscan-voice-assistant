# Copy to .env (optional). Real environment variables take precedence.

# --- LLM -------------------------------------------------------------------
# Leave both keys unset to run fully offline with the deterministic rules interpreter.
# With VISCAN_LLM_PROVIDER=auto: ANTHROPIC_API_KEY -> Claude, else GEMINI_API_KEY -> Gemini.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
VISCAN_LLM_PROVIDER=auto
# Optional override. Defaults: gemini-3.8-flash (Gemini) / claude-opus-5-5 (Claude)
VISCAN_MODEL=
# Effort per route (Gemini: thinking level; Claude: output_config.effort)
VISCAN_ROUTER_EFFORT=low
VISCAN_EXTRACTION_EFFORT=medium
VISCAN_LLM_TIMEOUT_S=30
VISCAN_LLM_MAX_RETRIES=1
# Claude only: server-side refusal fallback (beta server-side-fallback-2026-07-01)
VISCAN_LLM_FALLBACKS=true

# --- Speech-to-text ---------------------------------------------------------
# mock   = deterministic, recognises the bundled sample clips only (CI / demo)
# local  = faster-whisper on CPU, audio never leaves the machine (uv sync --extra stt-local)
# openai = OpenAI transcription API (uv sync --extra stt-openai, needs OPENAI_API_KEY)
VISCAN_STT_PROVIDER=mock
VISCAN_WHISPER_MODEL=base.en
VISCAN_OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_API_KEY=

# --- App ----------------------------------------------------------------------
# Mock identity used when a request has no X-Clinician-Id header
VISCAN_DEMO_CLINICIAN=dr-anand
VISCAN_MAX_UTTERANCE_CHARS=1000
VISCAN_MAX_TRANSCRIPT_CHARS=5000
VISCAN_SESSION_TTL_S=1800
# Set to empty to disable the file audit log
VISCAN_AUDIT_LOG=logs/audit.jsonl
